CREATE TABLE IF NOT EXISTS catalog_preview_cache (
    cache_key TEXT NOT NULL PRIMARY KEY,
    saved_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

selectPreview:
SELECT payload FROM catalog_preview_cache WHERE cache_key = ?;

replacePreview:
INSERT OR REPLACE INTO catalog_preview_cache(cache_key, saved_at, payload) VALUES (?, ?, ?);

deletePreview:
DELETE FROM catalog_preview_cache WHERE cache_key = ?;

deleteExpired:
DELETE FROM catalog_preview_cache WHERE saved_at <= :oldestAllowed OR saved_at > :now;

trimPreviews:
DELETE FROM catalog_preview_cache WHERE cache_key NOT IN (
    SELECT cache_key FROM catalog_preview_cache ORDER BY saved_at DESC, cache_key ASC LIMIT :maxEntries
);

previewCount:
SELECT count(*) FROM catalog_preview_cache;
